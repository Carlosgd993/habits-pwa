# Proyecto Supabase contra el que corre la PWA.
#
# Hay dos, uno por rama de habits-core:
#   habits-core-test  dkomeqbvhobkaulogibw  <- desarrollo
#   habits-core       ufyzpixnhrsltoxdqihn  <- produccion
#
# La clave publishable no es secreta: viaja en el JavaScript servido al
# navegador. Lo que protege los datos es la sesion de Supabase Auth y el
# contrato cerrado de habits-core, no ocultar esta cadena.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
